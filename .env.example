# Copy this file to .env.local and fill in real values for local development.
# Vercel/Netlify/Cloudflare Pages: set these in the project's environment
# variable dashboard. GitHub Pages: set them as repo Actions secrets and inject
# them at build time in the workflow.
#
# Variables prefixed with VITE_ are exposed to the browser bundle. Never put
# server-only secrets here.

# ---------------------------------------------------------------------------
# Backend mode
# ---------------------------------------------------------------------------
# 'local'    - localStorage only (current default; no backend needed)
# 'supabase' - read/write through Supabase (managed cloud OR self-hosted on a
#              Raspberry Pi: only the URL changes between the two)
VITE_DATA_BACKEND=local

# ---------------------------------------------------------------------------
# Supabase (used when VITE_DATA_BACKEND=supabase)
# ---------------------------------------------------------------------------
# Managed example: https://abcd1234.supabase.co
# Self-hosted on Pi example: https://supabase.yourhouse.local
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
